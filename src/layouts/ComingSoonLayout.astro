---
import BaseLayout from "./BaseLayout.astro";
import SealMark from "../components/brand/SealMark.astro";

interface Props {
  title: string;
  description: string;
  heading: string;
  text?: string;
  repere?: string;
  register?: "chaleur" | "rigueur";
}

const {
  title,
  description,
  heading,
  text,
  repere,
  register = "rigueur",
} = Astro.props;
---

<BaseLayout title={title} description={description} register={register}>
  <section
    class:list={[
      "coming-soon",
      {
        "bloc-inverse": register === "rigueur",
        "coming-soon--rigueur": register === "rigueur",
      },
    ]}
  >
    <div class="container reading-width">
      <div class="seal-watermark" aria-hidden="true">
        <SealMark size={40} variant={register === "rigueur" ? "negatif" : "filigrane"} />
      </div>
      <p class="eyebrow">En préparation</p>
      <h1>{heading}</h1>
      {repere && <p class="repere" aria-label="Position dans le site">Vous êtes ici · {repere}</p>}
      <p class="introduction">
        {
          text ||
            "Cette rubrique documentera la construction d’Orée. Elle ne contient pas encore de publication."
        }
      </p>

      <div class="actions">
        <a class="button button-secondary" href="/">Retour à l’accueil</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .coming-soon {
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .seal-watermark {
    margin-bottom: var(--space-4);
  }

  .eyebrow {
    margin-bottom: var(--space-4);
    color: var(--color-bark);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin-bottom: var(--space-6);
  }

  .introduction {
    margin-bottom: var(--space-8);
    color: var(--color-text-muted);
    font-size: var(--text-md);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-6);
    border: 2px solid transparent;
    border-radius: var(--radius-md);
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .button-secondary {
    border-color: var(--color-canopy);
    color: var(--color-canopy);
  }

  .button-secondary:hover {
    background: var(--color-canopy);
    color: var(--color-linen);
  }

  /*
   * Rupture Rigueur (correction Cockpit, 2 août 2026) : le fond utilise
   * désormais .bloc-inverse (Charcoal) au lieu de .bloc-plein (Vert Canopée),
   * pour marquer une vraie rupture avec le registre Chaleur, conformément à
   * l'intention du Lot 5 (« fond inversé, JetBrains Mono, un seul accent »).
   * .bloc-inverse fixe déjà le Lin sur h1/h2/h3/p/a et l'accent en bordure
   * gauche de .container ; seules les classes utilitaires ci-dessous
   * (absentes de .bloc-inverse) restent nécessaires ici.
   */
  .coming-soon--rigueur .eyebrow,
  .coming-soon--rigueur .repere,
  .coming-soon--rigueur .introduction {
    color: var(--color-linen);
  }

  .coming-soon--rigueur .button-secondary {
    border-color: var(--color-linen);
    color: var(--color-linen);
  }

  .coming-soon--rigueur .button-secondary:hover {
    background: var(--color-linen);
    color: var(--color-canopy);
  }
</style>
