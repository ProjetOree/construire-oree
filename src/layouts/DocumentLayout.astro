---
import BaseLayout from "./BaseLayout.astro";
import DocumentExplorer from "../components/editorial/DocumentExplorer.astro";

interface Frontmatter {
  title: string;
  seoTitle: string;
  description: string;
  contextPath: string;
  contextLabel: string;
  sourceUpdated: string;
  kind: "racine" | "profils" | "blueprint" | "roadmap" | "rejoindre";
  sectionStatuses?: Record<string, "acte" | "question-ouverte" | "reporte">;
}

const { frontmatter } = Astro.props as { frontmatter: Frontmatter };
const canonical = new URL(Astro.url.pathname, Astro.site);
const isBlueprint = frontmatter.kind === "blueprint";
const statusLabels = {
  acte: "ACTÉ",
  "question-ouverte": "QUESTION OUVERTE",
  reporte: "REPORTÉ",
};

// Only the presentation wraps generated Markdown tables; source stays intact.
const documentContent = await Astro.slots.render("default");
let tableNumber = 0;
let readableContent = documentContent
  .replace(/<table(?=[\s>])/g, () => {
    tableNumber += 1;
    return `<div class="document-table-scroll" role="region" tabindex="0" aria-label="Tableau ${tableNumber} à défilement horizontal"><table`;
  })
  .replace(/<\/table>/g, "</table></div>");

// Select named chapters in rendered HTML; the preserved Markdown is untouched.
const motionChapters: Record<Frontmatter["kind"], RegExp> = {
  racine: /Le Manifeste|La Vision|Explorer le projet/,
  profils: /^(Marc|Claire|Camille|Julien)\s*:/,
  blueprint: /Volet technique|Volet fiscal/,
  roadmap: /Phase [123] —/,
  rejoindre: /Espace (Bâtisseurs|Artistes|Éclaireurs|Échos)/,
};
readableContent = readableContent.replace(
  /<h2\b([^>]*)>([\s\S]*?)<\/h2>/g,
  (whole, attributes, content) =>
    motionChapters[frontmatter.kind].test(content.replace(/<[^>]*>/g, ""))
      ? `<h2${attributes} data-seuil-reveal="filet">${content}</h2>`
      : whole,
);

const summaries: Record<Frontmatter["kind"], { id: string; label: string }[]> =
  {
    racine: [],
    profils: [
      { id: "marc", label: "Marc" },
      { id: "claire", label: "Claire" },
      { id: "camille", label: "Camille" },
      { id: "julien", label: "Julien" },
    ],
    blueprint: [
      { id: "volet-technique", label: "Volet technique" },
      { id: "volet-fiscal-legal-operationnel", label: "Volet fiscal et légal" },
      { id: "section-1", label: "Architecture à double flux" },
      { id: "section-2", label: "Stack technique" },
      { id: "section-3", label: "Intermédiaires et clôture" },
      { id: "section-4", label: "Accompagnement comptable" },
      { id: "section-5", label: "Onboarding des créateurs" },
      { id: "section-6", label: "Conformité de lancement" },
      { id: "section-7", label: "Cadre opérationnel" },
    ],
    roadmap: [
      { id: "calendrier-historique", label: "Calendrier historique" },
      { id: "phase-1", label: "Phase 1" },
      { id: "seuils-phase-2", label: "Seuils envisagés" },
      { id: "phase-2", label: "Phase 2" },
      { id: "phase-3", label: "Phase 3" },
    ],
    rejoindre: [
      { id: "batisseurs", label: "Bâtisseurs" },
      { id: "artistes-artisans", label: "Artistes et artisans" },
      { id: "eclaireurs", label: "Éclaireurs" },
      { id: "echos", label: "Échos" },
      { id: "derniere-chose", label: "Une dernière chose" },
    ],
  };
// Current notes describe both blueprint parts as hypotheses still to verify.
// These labels qualify design maturity; they do not certify the source claims.
const sectionStatuses: Record<string, keyof typeof statusLabels> =
  frontmatter.sectionStatuses ??
  (isBlueprint
    ? Object.fromEntries(
        summaries.blueprint.map(({ id }) => [id, "question-ouverte"]),
      )
    : {});
if (isBlueprint) {
  readableContent = readableContent.replace(
    /<h2\b([^>]*)>([\s\S]*?)<\/h2>/g,
    (whole, attributes, content) => {
      const title = content.replace(/<[^>]*>/g, "");
      const number = title.match(/^([1-7])\./)?.[1];
      const sectionId = number
        ? `section-${number}`
        : title.includes("Volet technique")
          ? "volet-technique"
          : title.includes("Volet fiscal")
            ? "volet-fiscal-legal-operationnel"
            : undefined;
      const status = sectionId && sectionStatuses[sectionId];
      return status
        ? `<div class="document-chapter-heading"><h2${attributes}>${content}</h2><span class="document-status" data-status="${status}">${statusLabels[status]}</span></div>`
        : whole;
    },
  );
}
---

<BaseLayout
  title={frontmatter.seoTitle}
  description={frontmatter.description}
  composition="revue"
>
  <link slot="head" rel="canonical" href={canonical} />
  <article class:list={["document", { "document--blueprint": isBlueprint }]}>
    {frontmatter.kind === "racine" && <DocumentExplorer />}

    <header
      class:list={[
        "document-hero",
        { "document-hero--root": frontmatter.kind === "racine" },
      ]}
      id="document-source"
    >
      <div class="container">
        <p
          class="document-eyebrow"
          data-seuil-intro={frontmatter.kind !== "racine"
            ? "eyebrow"
            : undefined}
        >
          Document de conception · issu de Notion
        </p>
        {
          frontmatter.kind === "racine" ? (
            <h2 class="document-source-title">{frontmatter.title}</h2>
          ) : (
            <h1 data-seuil-intro="title">{frontmatter.title}</h1>
          )
        }
        <p class="document-provenance">
          Texte source conservé. La mention de dernière mise à jour du document
          indique le {frontmatter.sourceUpdated} ; le connecteur signalait une édition
          le 21 août 2026. Collecte pour cette migration : 20 septembre 2026. Les
          notes « Note actuelle » sont ajoutées par Construire Orée et ne font pas
          partie du texte source.
        </p>

        <nav class="document-returns" aria-label="Repères du corpus">
          {
            frontmatter.kind !== "racine" && (
              <a href="/documents/">Index des documents</a>
            )
          }
          <a href={frontmatter.contextPath}>{frontmatter.contextLabel}</a>
        </nav>
      </div>
    </header>

    <div class:list={[{ "document-reading-grid container": isBlueprint }]}>
      {
        frontmatter.kind !== "racine" && (
          <nav
            class:list={["document-summary", { container: !isBlueprint }]}
            aria-label="Sommaire du document"
          >
            <h2>Dans ce document</h2>
            <ul>
              {summaries[frontmatter.kind].map((section) => (
                <li>
                  <a href={`#${section.id}`}>{section.label}</a>
                  {sectionStatuses[section.id] && (
                    <span
                      class="document-status"
                      data-status={sectionStatuses[section.id]}
                    >
                      {statusLabels[sectionStatuses[section.id]]}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      <div class="document-body">
        <div class:list={[{ container: !isBlueprint }]}>
          <div class="document-prose" set:html={readableContent} />
        </div>
      </div>
    </div>

    <nav class="document-bottom container" aria-label="Retour après la lecture">
      {
        frontmatter.kind !== "racine" && (
          <a href="/documents/">Tous les documents</a>
        )
      }
      <a href={frontmatter.contextPath}>{frontmatter.contextLabel}</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .document-reading-grid {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
    padding-block: var(--space-12);
  }

  .document-reading-grid > .document-summary {
    position: sticky;
    top: 2rem;
    width: 100%;
    margin: 0;
    padding: 0 1.5rem 1.5rem 0;
    border-bottom: 0;
    border-right: 1px solid rgba(24, 43, 34, 0.12);
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
  }

  .document-reading-grid .document-summary ul {
    grid-template-columns: minmax(0, 1fr);
    padding-left: 0;
    list-style: none;
  }

  .document-reading-grid .document-summary h2 {
    font-size: 1.375rem;
  }

  .document-reading-grid .document-summary a {
    font-size: 1rem;
    line-height: 1.45;
  }

  .document-reading-grid .document-body {
    min-width: 0;
    padding-block: 0;
  }

  .document-status {
    display: block;
    width: fit-content;
    margin-block: 0.125rem 0.5rem;
    padding: 0.125rem 0.375rem;
    background: var(--color-linen);
    border: 1px solid rgba(24, 43, 34, 0.12);
    color: var(--color-canopy);
    font: 650 0.6875rem/1.5 var(--font-mono);
  }

  .document-status[data-status="question-ouverte"] {
    color: var(--color-terracotta);
  }

  .document-prose :global(.document-chapter-heading) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: start;
    justify-content: space-between;
    margin-block: var(--space-16) var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .document-prose :global(.document-chapter-heading h2) {
    flex: 1 1 22rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .document-prose :global(.document-chapter-heading .document-status) {
    flex: 0 0 auto;
    margin: 0.375rem 0 0;
    padding: 0.125rem 0.375rem;
    border: 1px solid rgba(24, 43, 34, 0.12);
    background: var(--color-linen);
    color: var(--color-terracotta);
    font: 650 0.6875rem/1.5 var(--font-mono);
  }

  .document-hero {
    padding-block: clamp(2.25rem, 5vw, 4rem) 2.75rem;
    background: var(--color-linen);
    scroll-margin-top: var(--space-4);
  }

  .document-hero.document-hero--root {
    padding-top: var(--space-6);
  }

  .document-hero .container,
  .document-summary,
  .document-bottom {
    max-width: 68.75rem;
  }

  .document-eyebrow {
    color: var(--color-bark);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  h1,
  .document-source-title {
    max-width: 22ch;
    margin-block: var(--space-4) var(--space-8);
    font-size: clamp(2.375rem, 4.6vw, 3.875rem);
  }

  .document-provenance {
    max-width: 75ch;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  .document-returns,
  .document-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
    margin-top: var(--space-8);
  }

  .document-returns a,
  .document-bottom a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
  }

  .document-summary {
    padding-block: 1.75rem 2.5rem;
    background: var(--color-canvas);
    border-bottom: 1px solid var(--color-border);
  }

  .document-summary h2 {
    margin-bottom: var(--space-4);
  }

  .document-summary ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.375rem 2rem;
    margin: 0;
    padding-left: var(--space-6);
  }

  .document-summary a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .document-body {
    padding-block: var(--space-12);
    background: var(--color-canvas);
  }

  .document-prose {
    max-width: 47.5rem;
    margin-inline: auto;
    font-size: 1.125rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .document-prose :global(h2) {
    margin-block: var(--space-16) var(--space-6);
    scroll-margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    font-size: 2rem;
  }

  .document-prose :global(h3),
  .document-prose :global(h4) {
    margin-block: var(--space-8) var(--space-4);
  }

  .document-prose :global(p),
  .document-prose :global(ul),
  .document-prose :global(ol),
  .document-prose :global(blockquote) {
    margin-bottom: var(--space-6);
  }

  .document-prose :global(blockquote) {
    margin-inline: 0;
    padding: var(--space-4) var(--space-6);
    border-left: 3px solid var(--color-action);
    background: var(--color-linen);
  }

  .document-prose :global(pre.astro-code span[style="color:#6a737d" i]) {
    color: #929ba5 !important;
  }

  .document-prose :global(span[id]) {
    display: block;
    scroll-margin-top: var(--space-8);
  }

  .document-prose :global(.document-table-scroll) {
    max-width: 100%;
    overflow-x: auto;
    margin-block: var(--space-6);
    overscroll-behavior-inline: contain;
  }

  .document-prose :global(table) {
    width: 100%;
    min-width: 40rem;
    border-collapse: collapse;
  }

  .document-prose :global(th),
  .document-prose :global(td) {
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  .document-prose :global(th) {
    background: var(--color-linen);
    color: var(--color-canopy);
  }

  .document-prose :global(.document-table-scroll:focus-visible) {
    outline-offset: 5px;
  }

  .document-bottom {
    padding-block: var(--space-8) var(--space-16);
  }

  @media (max-width: 48rem) {
    .document-reading-grid {
      grid-template-columns: minmax(0, 1fr);
      padding-block: var(--space-8);
      gap: var(--space-8);
    }
    .document-reading-grid > .document-summary {
      position: static;
      max-height: none;
      padding: 0 0 var(--space-6);
      border-right: 0;
      border-bottom: 1px solid rgba(24, 43, 34, 0.12);
    }
    .document-summary ul {
      grid-template-columns: 1fr;
    }
    .document-provenance {
      color: var(--color-text-muted);
      font-size: var(--text-sm);
      line-height: 1.6;
    }

    .document-summary,
    .document-body {
      padding-block: var(--space-8);
    }
  }

  @media (max-width: 30rem) {
    h1,
    .document-source-title {
      font-size: 2.25rem;
      overflow-wrap: anywhere;
    }
    .document-prose :global(h2) {
      font-size: 1.75rem;
    }
    .document-prose :global(blockquote) {
      padding: var(--space-4);
    }
  }
</style>
