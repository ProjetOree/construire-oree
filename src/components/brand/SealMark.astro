---
interface Props {
  size?: number;
  title?: string;
  variant?: "habite" | "filigrane" | "negatif";
}

const { size = 48, title, variant = "habite" } = Astro.props;

const isNegatif = variant === "negatif";
const backdropFill = isNegatif ? "#1B2E25" : "#F4ECE0";
const shellFill = isNegatif ? "#F4ECE0" : "#1B2E25";
const windowFill = isNegatif ? "#1B2E25" : "#F4ECE0";
---

<svg
  width={size}
  height={size}
  viewBox="0 0 200 200"
  xmlns="http://www.w3.org/2000/svg"
  role={title ? "img" : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : "true"}
  focusable="false"
  class={variant === "filigrane" ? "seal-filigrane" : undefined}
>
  <rect width="200" height="200" rx="44" fill={backdropFill}></rect>

  <path
    d="M100 27 C 134 25 160 44 169 78 C 175 100 174 122 168 140 C 159 164 132 174 102 173 C 74 172 45 169 33 141 C 24 121 25 95 31 75 C 39 44 66 29 100 27 Z"
    fill={shellFill}></path>

  <path
    d="M100 66 C 126 65 144 84 144 108 C 144 134 126 146 100 147 C 74 148 56 134 56 108 C 56 84 74 67 100 66 Z"
    fill={windowFill}></path>

  <circle cx="100" cy="66" r="10" fill="#E0A458"></circle>
</svg>
