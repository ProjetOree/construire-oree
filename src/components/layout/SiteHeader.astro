---
import SealMark from "../brand/SealMark.astro";

const pathname = Astro.url.pathname;

function isCurrent(path: string) {
  if (path === "/") return pathname === "/" ? "page" : undefined;
  const normalizedPathname = pathname.endsWith("/") ? pathname : `${pathname}/`;
  const normalizedPath = path.endsWith("/") ? path : `${path}/`;
  return normalizedPathname.startsWith(normalizedPath) ? "page" : undefined;
}
---

<header class="site-header">
  <div class="container header-inner">
    <a
      class="brand"
      href="/"
      aria-label="Construire Orée — Accueil"
      aria-current={isCurrent("/")}
    >
      <SealMark size={48} />
      <span class="brand-copy"
        ><span class="brand-kicker">Construire</span><span class="brand-name"
          >Or<span class="brand-accent">é</span>e</span
        ></span
      >
    </a>
    <div class="desktop-nav-container">
      <nav aria-label="Navigation principale" class="main-nav">
        <a href="/projet/" aria-current={isCurrent("/projet/")}>Projet</a>
        <a href="/ecosysteme/" aria-current={isCurrent("/ecosysteme/")}
          >Écosystème</a
        >
        <a href="/avancement/" aria-current={isCurrent("/avancement/")}
          >Avancement</a
        >
        <a href="/journal/" aria-current={isCurrent("/journal/")}>Journal</a>
        <a
          href="/rejoindre/"
          class="nav-join"
          aria-current={isCurrent("/rejoindre/")}>Participer</a
        >
      </nav>
      <span class="phase"
        ><span class="phase-dot" aria-hidden="true"></span>Point zéro</span
      >
    </div>
    <details class="mobile-nav-container">
      <summary class="menu-button">Menu</summary>
      <div class="mobile-nav-content">
        <nav aria-label="Navigation mobile" class="main-nav-mobile">
          <a href="/projet/" aria-current={isCurrent("/projet/")}>Projet</a>
          <a href="/ecosysteme/" aria-current={isCurrent("/ecosysteme/")}
            >Écosystème</a
          >
          <a href="/avancement/" aria-current={isCurrent("/avancement/")}
            >Avancement</a
          >
          <a href="/journal/" aria-current={isCurrent("/journal/")}>Journal</a>
          <a href="/rejoindre/" aria-current={isCurrent("/rejoindre/")}
            >Participer</a
          >
        </nav>
        <div class="mobile-phase">
          <span class="phase"
            ><span class="phase-dot" aria-hidden="true"></span>Point zéro</span
          >
        </div>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 50;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-canvas);
  }
  .header-inner {
    display: flex;
    min-height: 5.5rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-canopy);
    text-decoration: none;
  }
  .brand:hover {
    color: var(--color-moss);
  }
  .brand-copy {
    display: grid;
    line-height: 1;
  }
  .brand-kicker {
    margin-bottom: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-caption);
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.65rem;
    font-weight: 600;
  }
  .brand-accent {
    color: var(--color-dawn);
  }
  .phase {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: var(--space-2);
    padding-inline: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 650;
    white-space: nowrap;
  }
  .phase-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--color-dawn);
  }
  .desktop-nav-container {
    display: none;
    align-items: center;
    gap: var(--space-6);
  }
  .main-nav {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .main-nav a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition:
      color var(--transition-fast),
      text-decoration-color var(--transition-fast);
  }
  .main-nav a:hover,
  .main-nav a[aria-current="page"] {
    color: var(--color-canopy);
  }
  .main-nav a[aria-current="page"] {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--color-dawn);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4rem;
  }
  .nav-join {
    color: var(--color-action-hover) !important;
  }
  .nav-join:hover {
    color: var(--color-canopy) !important;
  }
  .mobile-nav-container {
    display: block;
  }
  .menu-button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding-inline: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-canopy);
    cursor: pointer;
    font-size: var(--text-sm);
    font-weight: 700;
    user-select: none;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast);
  }
  .mobile-nav-container[open] .menu-button {
    border-color: var(--color-canopy);
    background: var(--color-surface-soft);
  }
  .mobile-nav-content {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    padding: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-canvas);
    box-shadow: 0 1rem 2.5rem rgba(44, 40, 37, 0.08);
  }
  .main-nav-mobile {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .main-nav-mobile a {
    display: flex;
    min-height: 44px;
    align-items: center;
    padding-inline: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-md);
    font-weight: 600;
    text-decoration: none;
  }
  .main-nav-mobile a:hover,
  .main-nav-mobile a[aria-current="page"] {
    color: var(--color-canopy);
  }
  .main-nav-mobile a[aria-current="page"] {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--color-dawn);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35rem;
  }
  .mobile-phase {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  @media (max-width: 31rem) {
    .phase {
      padding-inline: var(--space-2);
      font-size: var(--text-caption);
    }
  }
  @media (min-width: 64rem) {
    .desktop-nav-container {
      display: flex;
    }
    .mobile-nav-container {
      display: none;
    }
  }
</style>
