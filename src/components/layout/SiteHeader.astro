---
import SealMark from "../brand/SealMark.astro";

const pathname = Astro.url.pathname;

function isCurrent(path: string) {
  if (path === "/") return pathname === "/" ? "page" : undefined;
  const normalizedPathname = pathname.endsWith("/") ? pathname : `${pathname}/`;
  const normalizedPath = path.endsWith("/") ? path : `${path}/`;
  return normalizedPathname.startsWith(normalizedPath) ? "page" : undefined;
}
---

<header class="site-header">
  <div class="container header-inner">
    <a
      class="brand"
      href="/"
      aria-label="Construire Orée — Accueil"
      aria-current={isCurrent("/")}
    >
      <span class="brand-seal" data-seuil-seal><SealMark size={46} /></span>
      <span class="brand-copy"
        ><span class="brand-kicker">Construire</span><span class="brand-name"
          >Or<span class="brand-accent">é</span>e</span
        ></span
      >
    </a>
    <div class="desktop-nav-container">
      <nav aria-label="Navigation principale" class="main-nav">
        <a href="/projet/" aria-current={isCurrent("/projet/")}>Projet</a>
        <a href="/avancement/" aria-current={isCurrent("/avancement/")}
          >Avancement</a
        >
        <a href="/journal/" aria-current={isCurrent("/journal/")}>Journal</a>
        <a href="/fondations/" aria-current={isCurrent("/fondations/")}
          >Fondations</a
        >
        <a
          href="/rejoindre/"
          class="nav-join"
          aria-current={isCurrent("/rejoindre/")}>Participer</a
        >
      </nav>
    </div>
    <details class="mobile-nav-container" data-seuil-menu>
      <summary class="menu-button" data-seuil-menu-trigger>
        <span class="menu-label menu-label--closed">Ouvrir le menu</span>
        <span class="menu-label menu-label--open">Fermer le menu</span>
      </summary>
      <div class="mobile-nav-content">
        <nav aria-label="Navigation mobile" class="main-nav-mobile">
          <a href="/projet/" aria-current={isCurrent("/projet/")}>Projet</a>
          <a href="/avancement/" aria-current={isCurrent("/avancement/")}
            >Avancement</a
          >
          <a href="/journal/" aria-current={isCurrent("/journal/")}>Journal</a>
          <a href="/fondations/" aria-current={isCurrent("/fondations/")}
            >Fondations</a
          >
          <a href="/rejoindre/" aria-current={isCurrent("/rejoindre/")}
            >Participer</a
          >
        </nav>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 50;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-canvas);
  }
  .header-inner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 5.875rem;
    padding-block: var(--space-4);
  }
  .brand {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-canopy);
    text-decoration: none;
  }
  .brand:hover {
    color: var(--color-moss);
  }
  .brand-copy {
    display: grid;
    line-height: 1;
  }
  .brand-seal {
    flex: 0 0 auto;
  }
  .brand-kicker {
    margin-bottom: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-caption);
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
  }
  .brand-accent {
    color: var(--color-dawn);
  }
  .desktop-nav-container {
    display: none;
    align-items: center;
    gap: var(--space-6);
  }
  .main-nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }
  .main-nav a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
  }
  .main-nav a:hover,
  .main-nav a[aria-current="page"] {
    color: var(--color-canopy);
  }
  .main-nav a[aria-current="page"] {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--color-dawn);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4rem;
  }
  .nav-join {
    color: var(--color-action-hover) !important;
  }
  .nav-join:hover {
    color: var(--color-canopy) !important;
  }
  .mobile-nav-container {
    display: block;
    margin-left: auto;
    min-width: 0;
  }
  .mobile-nav-container[open] {
    flex-basis: 100%;
  }
  .menu-button {
    display: flex;
    width: fit-content;
    margin-left: auto;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding-inline: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    color: var(--color-canopy);
    cursor: pointer;
    font-size: var(--text-sm);
    font-weight: 700;
    user-select: none;
    list-style: none;
  }
  .menu-button::-webkit-details-marker {
    display: none;
  }
  .mobile-nav-container[open] .menu-button {
    border-color: var(--color-canopy);
    background: var(--color-surface-soft);
  }
  .menu-label--open {
    display: none;
  }
  .mobile-nav-container[open] .menu-label--closed {
    display: none;
  }
  .mobile-nav-container[open] .menu-label--open {
    display: inline;
  }
  .mobile-nav-content {
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
  }
  @media (max-width: 22rem) {
    .brand {
      gap: var(--space-1);
    }
    .brand-seal :global(svg) {
      width: 40px;
      height: 40px;
    }
    .brand-kicker {
      font-size: 0.68rem;
      letter-spacing: 0.08em;
    }
    .brand-name {
      font-size: 1.4rem;
    }
  }
  .main-nav-mobile {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .main-nav-mobile a {
    display: flex;
    min-height: 44px;
    align-items: center;
    padding-inline: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-md);
    font-weight: 600;
    text-decoration: none;
  }
  .main-nav-mobile a:hover,
  .main-nav-mobile a[aria-current="page"] {
    color: var(--color-canopy);
  }
  .main-nav-mobile a[aria-current="page"] {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--color-dawn);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35rem;
  }
  @media (min-width: 64rem) {
    .header-inner {
      display: flex;
      flex-wrap: nowrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
    }
    .brand {
      min-height: auto;
    }
    .desktop-nav-container {
      display: flex;
    }
    .mobile-nav-container {
      display: none;
    }
  }
</style>
