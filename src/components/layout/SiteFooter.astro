---
import SealMark from "../brand/SealMark.astro";
import { siteConfig } from "../../config/site";
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <div class="footer-lockup">
        <SealMark size={44} />
        <p class="footer-title">Construire Orée</p>
      </div>
      <p class="footer-description">
        Le journal public d’une future marketplace éthique, construit sans
        inventer ce qui n’existe pas encore.
      </p>
    </div>

    <nav aria-label="Plan du site" class="footer-nav">
      <div class="footer-column">
        <p class="footer-heading">Découvrir</p>
        <ul role="list">
          <li><a href="/projet/">Projet</a></li>
          <li><a href="/ecosysteme/">Écosystème</a></li>
          <li><a href="/a-propos/">À propos</a></li>
        </ul>
      </div>
      <div class="footer-column">
        <p class="footer-heading">Suivre la construction</p>
        <ul role="list">
          <li><a href="/avancement/">Avancement</a></li>
          <li><a href="/journal/">Journal</a></li>
          <li><a href="/fondations/">Fondations</a></li>
        </ul>
      </div>
      <div class="footer-column">
        <p class="footer-heading">Agir</p>
        <ul role="list">
          <li><a href="/rejoindre/">Participer</a></li>
          <li>
            <a href={siteConfig.links.forumWelcome}>Discussions publiques</a>
          </li>
          <li>
            <a href={siteConfig.links.follow}
              >Suivre l’aventure (formulaire externe)</a
            >
          </li>
          <li>
            <a href={siteConfig.links.contact}
              >Écrire à Orée (formulaire externe)</a
            >
          </li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="container footer-legal">
    <p>
      Code sous GNU AGPL version 3 seulement ({siteConfig.licensing.code}).
      Prose éditoriale originale concernée sous licence{" "}
      {siteConfig.licensing.editorialContent}. La marque Orée, Le Sceau, le
      favicon et l’image sociale sont exclus de ces licences ; droits de marque
      et copyright réservés. Code source sur{" "}
      <a href={siteConfig.repository.url}>GitHub</a>.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-24);
    padding-block: var(--space-12) var(--space-6);
    border-top: 2px solid var(--color-dawn);
    background: var(--color-canopy);
    color: var(--color-linen);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--space-12);
  }

  .footer-lockup {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .footer-title {
    margin: 0;
    color: var(--color-linen);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .footer-description {
    margin-bottom: 0;
    color: var(--color-linen);
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .footer-heading {
    margin-bottom: var(--space-3);
    color: var(--color-dawn);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-column ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-column a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--color-linen);
    font-weight: 650;
    text-decoration-color: var(--color-dawn);
  }

  .footer-column a:hover {
    color: var(--color-white);
  }

  .footer-legal {
    margin-top: var(--space-12);
    padding-top: var(--space-4);
    border-top: 1px solid rgba(244, 236, 224, 0.55);
    color: var(--color-linen);
    font-size: var(--text-caption);
  }

  .footer-legal p {
    margin-bottom: 0;
  }

  .footer-legal a {
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    color: var(--color-linen);
    text-decoration-color: var(--color-dawn);
  }

  .footer-legal a:hover {
    color: var(--color-white);
  }

  .site-footer :is(a, button, summary):focus-visible {
    outline-color: var(--color-linen);
    box-shadow: 0 0 0 3px var(--color-canopy);
  }

  @media (max-width: 45rem) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .footer-nav {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  @media (min-width: 45.01rem) and (max-width: 60rem) {
    .footer-nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
