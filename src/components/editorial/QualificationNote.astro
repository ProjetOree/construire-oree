---
interface Props {
  label: string;
  kind?: "fact" | "documented" | "open" | "decision" | "hypothesis";
}

const { label, kind = "fact" } = Astro.props;
---

<article class="qualification-note" data-qualification={kind}>
  <p class="qualification-note__label">{label}</p>
  <div class="qualification-note__body">
    <slot />
  </div>
</article>

<style>
  .qualification-note {
    position: relative;
  }

  .qualification-note::before {
    position: absolute;
    top: var(--space-6);
    left: 0;
    width: 2px;
    height: var(--space-6);
    background: var(--composition-accent-revue);
    content: "";
  }

  .qualification-note__label {
    margin-bottom: var(--space-3);
    color: var(--color-canopy);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .qualification-note__body :global(p:last-child) {
    margin-bottom: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  @media (forced-colors: active) {
    .qualification-note::before {
      background: CanvasText;
    }
  }
</style>
