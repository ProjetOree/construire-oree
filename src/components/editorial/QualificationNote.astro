---
interface Props {
  label: string;
  kind?: "fact" | "documented" | "open" | "decision" | "hypothesis";
}

const { label, kind = "fact" } = Astro.props;
---

<article class="qualification-note" data-qualification={kind}>
  <p class="qualification-note__label">{label}</p>
  <div class="qualification-note__body">
    <slot />
  </div>
</article>

<style>
  .qualification-note {
    padding-left: var(--space-4);
    border-left: 1px solid var(--seuil-rule);
  }

  .qualification-note__label {
    margin-bottom: var(--space-3);
    color: var(--color-canopy);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .qualification-note__body :global(p:last-child) {
    margin-bottom: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  @media (forced-colors: active) {
    .qualification-note {
      border-color: CanvasText;
    }
  }
</style>
