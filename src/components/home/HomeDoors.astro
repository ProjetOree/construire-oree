---
interface Door {
  index: string;
  title: string;
  copy: string;
  href: string;
}
interface Props {
  doors: Door[];
}
const { doors } = Astro.props;
---

<section class="home-orientation" aria-labelledby="orientation-title">
  <div class="container">
    <p class="section-kicker">Orientation</p>
    <h2 id="orientation-title">Cinq portes</h2>
    <ol class="door-list">
      {
        doors.map((door) => (
          <li>
            <a href={door.href} class="door-link" data-seuil-door>
              <>
                <span class="door-index" aria-hidden="true">
                  {door.index}
                </span>
                <span class="door-content">
                  <>
                    <span class="door-title">{door.title}</span>
                    <span class="door-copy">{door.copy}</span>
                  </>
                </span>
                <span
                  class="door-arrow"
                  aria-hidden="true"
                  data-seuil-door-arrow
                >
                  →
                </span>
              </>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>
<style>
  .home-orientation {
    background: var(--color-linen);
    padding-block: 1.875rem 2.25rem;
  }
  .section-kicker {
    margin: 0 0 0.375rem;
    padding-left: 0.75rem;
    border-left: 1px solid var(--seuil-rule);
    color: var(--color-bark);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  h2 {
    font-size: 1.875rem;
    margin: 0 0 1.5rem;
  }
  .door-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
    list-style: none;
  }
  .door-list li {
    max-width: none;
    min-width: 0;
    border-bottom: 1px solid var(--color-border);
  }
  .door-link {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr) 1.5rem;
    align-items: center;
    gap: 0.75rem;
    padding: 1.5rem 0.5rem;
    min-height: 6.25rem;
    height: 100%;
    color: var(--color-text);
    text-decoration: none;
  }
  .door-link:is(:hover, :focus-visible) {
    background: var(--color-canvas);
    color: var(--color-text);
  }
  .door-index {
    color: var(--color-action);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .door-content {
    display: grid;
    gap: 0.75rem;
  }
  .door-title {
    color: var(--color-canopy);
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.15;
    text-wrap: pretty;
  }
  .door-copy {
    color: var(--color-text-muted);
    font-size: 1rem;
  }
  .door-arrow {
    color: var(--color-action);
    font-size: 1.5rem;
  }
  @media (min-width: 75rem) {
    .door-list {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      border-bottom: 1px solid var(--color-border);
    }
    .door-list li {
      border-bottom: 0;
      border-right: 1px solid var(--color-border);
    }
    .door-list li:last-child {
      border-right: 0;
    }
    .door-link {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      min-height: 13.75rem;
      padding: 1.5rem 1.125rem;
    }
    .door-arrow {
      margin-top: auto;
    }
  }
</style>
