---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("journal");
  // On exclut strictement les brouillons des routes générées
  const publishedEntries = entries.filter((entry) => entry.data.draft !== true);

  return publishedEntries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="container reading-width journal-entry">
    <header class="entry-header">
      <p class="eyebrow">Journal</p>
      <h1>{entry.data.title}</h1>
      {
        entry.data.publishedAt && (
          <time datetime={entry.data.publishedAt.toISOString()}>
            {new Date(entry.data.publishedAt).toLocaleDateString("fr-FR", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .journal-entry {
    padding-block: clamp(4rem, 10vw, 6rem) var(--space-8);
  }

  .entry-header {
    margin-bottom: var(--space-12);
  }

  .eyebrow {
    margin-bottom: var(--space-4);
    color: var(--color-bark);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin-bottom: var(--space-4);
  }

  time {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .prose {
    color: var(--color-text);
  }

  .prose :global(h2) {
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
  }

  .prose :global(p) {
    margin-bottom: var(--space-4);
  }

  .prose :global(ul) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
  }

  .prose :global(li) {
    margin-bottom: var(--space-2);
  }

  .prose :global(a) {
    color: var(--color-primary);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  .prose :global(a:hover) {
    color: var(--color-primary-hover);
  }
</style>
