---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("journal");
  // On exclut strictement les brouillons des routes générées
  const publishedEntries = entries.filter(
    (entry) => !entry.data.draft && entry.data.publishedAt,
  );

  return publishedEntries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const shortTitle = entry.data.title.replace(/\s+sur Construire Orée$/u, "");
const dateTime = entry.data.publishedAt?.toISOString().slice(0, 10);
const publishedDate = entry.data.publishedAt?.toLocaleDateString("fr-FR", {
  timeZone: "UTC",
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={shortTitle} description={entry.data.description}>
  <article class="container reading-width journal-entry">
    <header class="entry-header">
      <p class="eyebrow"><a href="/journal/">Journal</a></p>
      <h1>{entry.data.title}</h1>
      {
        dateTime && publishedDate && (
          <time datetime={dateTime}>{publishedDate}</time>
        )
      }
    </header>

    <aside class="entry-context" aria-label="Contexte du billet">
      Ce billet est une trace publiée à la date indiquée. Pour l’état présent du
      projet, consulter <a href="/avancement/">Avancement</a>.
    </aside>

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .journal-entry {
    padding-block: clamp(4rem, 10vw, 6rem) var(--space-8);
  }

  .entry-header {
    margin-bottom: var(--space-12);
    max-width: 40rem;
  }

  .eyebrow {
    margin-bottom: var(--space-4);
    color: var(--color-bark);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .eyebrow a {
    color: inherit;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  h1 {
    margin-bottom: var(--space-4);
  }

  time {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .entry-context {
    max-width: 40rem;
    margin-bottom: var(--space-8);
    padding: var(--space-4);
    border-left: 2px solid var(--color-dawn);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .entry-context a {
    font-weight: 700;
  }

  .prose {
    color: var(--color-text);
    font-size: var(--text-md);
    line-height: 1.7;
  }

  .prose :global(h2) {
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    max-width: 40rem;
  }

  .prose :global(p) {
    margin-bottom: var(--space-4);
    max-width: 40rem;
  }

  .prose :global(ul) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
    max-width: 40rem;
  }

  .prose :global(li) {
    margin-bottom: var(--space-2);
    padding-left: var(--space-1);
  }

  .prose :global(a) {
    color: var(--color-primary);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  .prose :global(a:hover) {
    color: var(--color-primary-hover);
  }

  .prose :global(:not(pre) > code) {
    padding: 0.08em 0.3em;
    border-radius: 0.15em;
    background: var(--color-surface);
    font-size: 0.9em;
  }

  @media (max-width: 24rem) {
    h1 {
      font-size: 2.25rem;
    }
  }

  @media (forced-colors: active) {
    .entry-context {
      border-color: CanvasText;
    }
  }
</style>
