---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allEntries = await getCollection("journal");
const publishedEntries = allEntries
  .filter((entry) => !entry.data.draft && entry.data.publishedAt)
  .sort((a, b) => {
    const dateA = a.data.publishedAt
      ? new Date(a.data.publishedAt).valueOf()
      : 0;
    const dateB = b.data.publishedAt
      ? new Date(b.data.publishedAt).valueOf()
      : 0;
    return dateB - dateA;
  });
---

<BaseLayout
  title="Journal de Construire Orée"
  description="Le Journal de Construire Orée présente uniquement les contenus réellement publiés et indique honnêtement lorsqu’aucun billet n’est disponible."
>
  <section class="journal-intro">
    <div class="container reading-width">
      <p class="eyebrow">Journal</p>
      <h1>Le Journal de Construire Orée</h1>
      <p class="repere">Vous êtes ici · Journal</p>
      <div class="introduction">
        <p>
          Ce Journal documentera la construction réelle de Construire Orée à
          mesure que des billets seront publiés. Chaque billet distinguera ce
          qui est déjà versionné sur le site, ce qui reste à construire pour
          Orée et les décisions qui ne sont pas encore prises.
        </p>
        <p>
          Orée est une future marketplace éthique au point zéro. Construire Orée
          est son site statique et son journal public : ici, une intention ne
          devient jamais un résultat par simple formulation.
        </p>
      </div>
    </div>
  </section>

  <div class="container reading-width journal-index">
    <section class="entries-section">
      {
        publishedEntries.length === 0 ? (
          <p class="empty-state">Aucun billet n’est publié pour le moment.</p>
        ) : (
          <ul class="entries-list" role="list">
            {publishedEntries.map((entry) => (
              <li>
                {entry.data.publishedAt && (
                  <time
                    datetime={entry.data.publishedAt.toISOString().slice(0, 10)}
                  >
                    {entry.data.publishedAt.toLocaleDateString("fr-FR", {
                      timeZone: "UTC",
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </time>
                )}
                <h2>{entry.data.title}</h2>
                <p>{entry.data.description}</p>
                <a href={`/journal/${entry.id}/`} class="read-more">
                  Lire « {entry.data.title} »
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>
</BaseLayout>

<style>
  .eyebrow {
    margin-bottom: var(--space-4);
    color: var(--color-bark);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin-bottom: var(--space-4);
  }

  .journal-intro {
    padding-block: clamp(4rem, 10vw, 6rem) var(--space-12);
  }

  .introduction {
    margin-top: var(--space-8);
    font-size: var(--text-md);
    line-height: 1.65;
  }

  .introduction p {
    margin-bottom: var(--space-4);
  }

  .introduction p:last-child {
    margin-bottom: 0;
  }

  .journal-index {
    padding-block: var(--space-8) var(--space-12);
  }

  .empty-state {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .entries-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .entries-list li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 40rem;
  }

  .entries-list time {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .entries-list h2 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .entries-list p {
    margin-bottom: var(--space-3);
    line-height: 1.6;
  }

  .read-more {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }
</style>
