---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allEntries = await getCollection("journal");
const publishedEntries = allEntries
  .filter((entry) => entry.data.draft !== true)
  .sort((a, b) => {
    const dateA = a.data.publishedAt
      ? new Date(a.data.publishedAt).valueOf()
      : 0;
    const dateB = b.data.publishedAt
      ? new Date(b.data.publishedAt).valueOf()
      : 0;
    return dateB - dateA;
  });
---

<BaseLayout
  title="Journal — fondations et décisions"
  description="Le journal public de Construire Orée : fondations vérifiées, décisions et limites d’une future marketplace éthique au point zéro."
  register="rigueur"
>
  <div class="container reading-width journal-index">
    <p class="eyebrow">Journal</p>
    <h1>Le Journal de Construire Orée</h1>
    <p class="repere" aria-label="Position dans le site">Vous êtes ici · Journal</p>

    <div class="introduction">
      <p>
        Ce Journal documente la construction réelle de Construire Orée. Il
        distingue ce qui est déjà versionné sur le site, ce qui reste à
        construire pour Orée et les décisions qui ne sont pas encore prises.
      </p>
      <p>
        Orée est une future marketplace éthique au point zéro. Construire Orée
        est son site statique et son journal public : ici, une intention ne
        devient jamais un résultat par simple formulation.
      </p>
    </div>

    <section class="entries-section">
      {
        publishedEntries.length === 0 ? (
          <p class="empty-state">Aucun billet n’est publié pour le moment.</p>
        ) : (
          <ul class="entries-list">
            {publishedEntries.map((entry) => (
              <li>
                {entry.data.publishedAt && (
                  <time datetime={entry.data.publishedAt.toISOString()}>
                    {new Date(entry.data.publishedAt).toLocaleDateString(
                      "fr-FR",
                      {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                      },
                    )}
                  </time>
                )}
                <h2>
                  <a href={`/journal/${entry.id}/`}>{entry.data.title}</a>
                </h2>
                <p>{entry.data.description}</p>
                <a href={`/journal/${entry.id}/`} class="read-more">
                  Lire « {entry.data.title} »
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>
</BaseLayout>

<style>
  .journal-index {
    padding-block: clamp(4rem, 10vw, 6rem) var(--space-8);
  }

  .eyebrow {
    margin-bottom: var(--space-4);
    color: var(--color-bark);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin-bottom: var(--space-6);
  }

  .introduction {
    margin-bottom: var(--space-12);
    color: var(--color-text-muted);
    font-size: var(--text-md);
  }

  .introduction p {
    margin-bottom: var(--space-4);
  }

  .entries-section {
    margin-top: var(--space-12);
  }

  .empty-state {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .entries-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .entries-list li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .entries-list time {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .entries-list h2 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .entries-list h2 a {
    color: inherit;
    text-decoration: none;
  }

  .entries-list h2 a:hover {
    color: var(--color-primary);
  }

  .entries-list p {
    margin-bottom: var(--space-3);
  }

  .read-more {
    font-size: var(--text-sm);
    font-weight: 600;
  }
</style>
