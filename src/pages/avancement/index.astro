---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChapterHeader from "../../components/editorial/ChapterHeader.astro";
import ConstructionState from "../../components/structure/ConstructionState.astro";
---

<BaseLayout
  title="Avancement d’Orée : état et suivi"
  description="L’état actuel vérifiable de Construire Orée, la prochaine étape documentable et la trajectoire conditionnelle, avec des vues de suivi détaillées."
  register="rigueur"
  composition="chantier"
>
  <section class="hero-section">
    <div class="container reading-width">
      <ChapterHeader
        eyebrow="Avancement"
        title="Orée est au point zéro"
        repere="Vous êtes ici · Avancement"
        introduction="Cette page dit ce qui existe, ce qui n’existe pas, et ce qui est en cours d’examen — sans date inventée et sans promesse de calendrier."
        composition="chantier"
      />
    </div>
  </section>

  <section class="section-block">
    <div class="container reading-width">
      <h2>État actuel vérifiable</h2>
      <div class="etat-grid">
        <ConstructionState label="Éléments publiés" state="published">
          <p>
            Un site public qui documente la construction ; une direction
            éditoriale et visuelle validée ; une architecture de contenu qui
            organise le site autour de cinq questions.
          </p>
        </ConstructionState>
        <ConstructionState label="Capacités absentes" state="absent">
          <p>
            Aucune marketplace ouverte ; aucun catalogue, aucune vente, aucun
            utilisateur de marketplace ; aucune structure coopérative
            constituée.
          </p>
        </ConstructionState>
        <ConstructionState label="Questions en examen" state="review">
          <p>
            Le document de travail technique et fiscal (voir Fondations) ; les
            statuts possibles pour les personnes qui créent ; le traitement
            d’éventuels retours reçus via le formulaire externe de contribution.
          </p>
        </ConstructionState>
      </div>
    </div>
  </section>

  <section class="section-block bloc-inverse">
    <div class="container reading-width">
      <h2>Prochaine étape documentable</h2>
      <p>
        Le travail en cours consiste à documenter les fondations prioritaires et
        à tenir à jour l’état réel du projet sur ce site. Il reste porté en
        solo, sans équipe constituée. Les preuves attendues sont les mises à
        jour effectivement publiées et, lorsqu’ils existeront, les billets du
        Journal ; aucune date n’est fixée à l’avance.
      </p>
    </div>
  </section>

  <section class="section-block">
    <div class="container reading-width">
      <h2>Trajectoire conditionnelle</h2>
      <ol class="trajectoire-list" role="list">
        <li>
          <p class="trajectoire-label">Phase 1</p>
          <p>
            Tester un premier MVP, une fois les fondations prioritaires
            résolues.
          </p>
        </li>
        <li>
          <p class="trajectoire-label">Phase 2</p>
          <p>
            Automatiser certains parcours, si des signaux mesurables
            apparaissent.
          </p>
        </li>
        <li>
          <p class="trajectoire-label">Phase 3</p>
          <p>
            Envisager La Canopée, après validation du modèle économique et
            juridique.
          </p>
        </li>
      </ol>
      <p class="context-note">
        Chaque phase est conditionnée à la précédente ; aucune n’est planifiée à
        une date fixe.
      </p>
    </div>
  </section>

  <section class="section-block point-zero-block">
    <div class="container reading-width">
      <h2>Trois vues de suivi en préparation</h2>
      <p>
        Ces pages secondaires rendent leur état visible, mais elles ne
        constituent pas encore des preuves publiées ni des sources complètes.
      </p>
      <ul class="preuves-list" role="list">
        <li><a href="/roadmap/">Voir la Roadmap en préparation</a></li>
        <li><a href="/decisions/">Voir les décisions en préparation</a></li>
        <li>
          <a href="/tableau-de-bord/">Voir le tableau de bord en préparation</a>
        </li>
      </ul>
      <div class="actions">
        <a class="button button-primary" href="/journal/"
          >Voir l’état du Journal</a
        >
        <a class="button button-secondary" href="/fondations/"
          >Voir les fondations à résoudre</a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    padding-block: clamp(4rem, 10vw, 6rem) var(--space-8);
  }

  .section-block {
    padding-block: var(--space-12);
  }

  .section-block h2 {
    margin-bottom: var(--space-6);
  }

  .bloc-inverse {
    padding-bottom: var(--space-16);
  }

  .etat-grid {
    display: grid;
    gap: var(--space-4);
  }

  .trajectoire-list {
    display: grid;
    gap: var(--space-4);
    margin: 0 0 var(--space-4);
    padding-left: var(--space-6);
  }

  .trajectoire-label {
    margin-bottom: var(--space-1);
    color: var(--color-canopy);
    font-weight: 700;
  }

  .trajectoire-list p:last-child {
    margin-bottom: 0;
    color: var(--color-text-muted);
  }

  .context-note {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .preuves-list {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-4) 0 var(--space-6);
    padding: 0;
    list-style: none;
  }

  .point-zero-block {
    border-top: 1px solid var(--color-border);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-6);
    border: 2px solid transparent;
    border-radius: var(--radius-md);
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .button-primary {
    background: var(--color-action-hover);
    color: var(--color-white);
  }

  .button-primary:hover {
    background: var(--color-canopy);
    color: var(--color-linen);
  }

  .button-secondary {
    border-color: var(--color-canopy);
    color: var(--color-canopy);
  }

  .button-secondary:hover {
    background: var(--color-canopy);
    color: var(--color-linen);
  }

  @media (min-width: 48rem) {
    .etat-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .trajectoire-list {
      grid-template-columns: repeat(3, 1fr);
      padding-left: 0;
      list-style: none;
    }
  }
</style>
