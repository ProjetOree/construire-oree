---
import BaseLayout from "../layouts/BaseLayout.astro";
import SealMark from "../components/brand/SealMark.astro";
import { siteConfig } from "../config/site";

const utm = "?utm_source=construire-oree&utm_medium=liens&utm_campaign=bio";

const links = [
  {
    id: "decouvrir",
    label: "Découvrir Orée",
    url: "/projet/",
    type: "primary",
    detail: "Présentation du projet · sur ce site",
  },
  {
    id: "rejoindre",
    label: "Rejoindre Orée",
    url: siteConfig.links.join + utm,
    type: "primary",
    detail: "Formulaire de participation · Tally",
  },
  {
    id: "suivre",
    label: "Suis l’aventure — newsletter",
    url: siteConfig.links.follow + utm,
    type: "primary",
    detail: "Formulaire de suivi par courriel · Tally",
  },
  {
    id: "linkedin",
    label: "LinkedIn",
    url: siteConfig.social.linkedin + utm,
    type: "secondary",
    detail: "Profil sur LinkedIn · service externe",
  },
  {
    id: "contact",
    label: "Écris à Orée",
    url: siteConfig.links.contact + utm,
    type: "secondary",
    detail: "Formulaire de contact · Tally",
  },
];
---

<BaseLayout
  title="Liens"
  description="Retrouvez tous les liens d’Orée."
  hideChrome={true}
>
  <div class="liens-wrapper">
    <div class="liens-container">
      <header class="liens-header">
        <h1 class="visually-hidden">Liens d’Orée</h1>
        <a class="brand-home" href="/" aria-label="Accueil de Construire Orée">
          <SealMark size={64} title="Sceau Orée" />
        </a>
        <p class="liens-description">
          Le point zéro de la construction d’Orée, une future marketplace
          éthique. La plateforme n’existe pas encore.
        </p>
      </header>

      <nav class="liens-list" aria-label="Liens Orée">
        {
          links.map((link) => (
            <div class="liens-entry">
              <a
                href={link.url}
                class={`lien-bouton lien-${link.type}`}
                aria-describedby={`lien-${link.id}-detail`}
              >
                {link.type === "secondary" && (
                  <span class="puce-ambre" aria-hidden="true" />
                )}
                {link.label}
              </a>
              <p class="liens-detail" id={`lien-${link.id}-detail`}>
                {link.detail}
              </p>
            </div>
          ))
        }
      </nav>
    </div>
  </div>
</BaseLayout>

<style is:global>
  body {
    background-color: var(--color-linen);
  }
</style>

<style>
  .liens-wrapper {
    --hover-canopy: #2a473a;
    --hover-linen: #ebe0cf;
    display: flex;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
    min-height: 100vh;
    min-height: 100dvh;
    padding: var(--space-8) var(--space-4);
    background-image: radial-gradient(
      circle at bottom center,
      rgba(224, 164, 88, 0.24) 0%,
      transparent 70%
    );
    background-repeat: no-repeat;
  }

  .liens-container {
    width: 100%;
    max-width: 24rem; /* 384px */
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .liens-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .liens-description {
    color: var(--color-charcoal);
    font-size: var(--text-md);
    margin: 0;
    font-weight: 500;
  }

  .brand-home {
    display: inline-flex;
    border-radius: var(--radius-lg);
  }

  .liens-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .liens-entry {
    display: grid;
    gap: var(--space-1);
  }

  .liens-detail {
    margin: 0;
    color: var(--color-bark);
    font-size: var(--text-sm);
    line-height: 1.4;
    text-align: center;
  }

  .lien-bouton {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 56px; /* Cible tactile >= 44px */
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-lg);
    font-weight: 700;
    font-size: var(--text-base);
    text-decoration: none;
    text-align: center;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background-color 0.2s ease;
    gap: var(--space-3);
  }

  .lien-bouton:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(27, 46, 37, 0.08);
  }

  /* Boutons pleins (1-2) */
  .lien-primary {
    background-color: var(--color-canopy);
    color: var(--color-linen);
    border: 2px solid var(--color-canopy);
  }

  .lien-primary:hover,
  .lien-primary:visited {
    background-color: var(--hover-canopy);
    border-color: var(--hover-canopy);
    color: var(--color-linen);
  }

  .lien-primary:visited:not(:hover) {
    background-color: var(--color-canopy);
    border-color: var(--color-canopy);
  }

  /* Boutons doux (3-5) */
  .lien-secondary {
    background-color: var(--color-linen);
    color: var(--color-charcoal);
    border: 2px solid var(--color-canopy);
  }

  .lien-secondary:hover,
  .lien-secondary:visited {
    background-color: var(--hover-linen);
    color: var(--color-charcoal);
  }

  .lien-secondary:visited:not(:hover) {
    background-color: var(--color-linen);
  }

  .puce-ambre {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--color-dawn);
    flex-shrink: 0;
  }
</style>
