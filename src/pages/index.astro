---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";

const publishedEntries = (await getCollection("journal"))
  .filter((entry) => !entry.data.draft && entry.data.publishedAt)
  .sort((a, b) => {
    const dateA = a.data.publishedAt?.valueOf() ?? 0;
    const dateB = b.data.publishedAt?.valueOf() ?? 0;
    return dateB - dateA;
  });
const latestEntry = publishedEntries[0];

const doors = [
  {
    index: "01",
    title: "Comprendre — Projet",
    copy: "Découvrir présente le problème, la vision et le modèle envisagé.",
    href: "/projet/",
  },
  {
    index: "02",
    title: "Vérifier — Avancement",
    copy: "L’état réel et vérifiable, sans date inventée.",
    href: "/avancement/",
  },
  {
    index: "03",
    title: "Lire — Journal",
    copy: "Ce Journal documentera la construction réelle de Construire Orée à mesure que des billets seront publiés.",
    href: "/journal/",
  },
  {
    index: "04",
    title: "Approfondir — Fondations",
    copy: "Le travail actuel consiste à documenter les fondations.",
    href: "/fondations/",
  },
  {
    index: "05",
    title: "Participer — Rejoindre",
    copy: "Participer explique les rôles et ce qu’il est possible de proposer aujourd’hui.",
    href: "/rejoindre/",
  },
];
---

<BaseLayout
  title="Journal public d’un projet au point zéro"
  description="Construire Orée documente, au point zéro, la construction publique d’une future marketplace éthique pour la création originale faite main."
  composition="sceau"
>
  <section class="home-threshold" aria-labelledby="home-title">
    <div class="container home-threshold-grid">
      <div class="threshold-copy">
        <p class="section-kicker section-kicker--inverse">
          Journal public de construction
        </p>
        <h1 id="home-title">Construire Orée depuis le point zéro</h1>
        <p class="threshold-introduction">
          Orée est une future marketplace éthique pour la création originale,
          l’art et l’artisanat d’art, pensée dans une perspective d’économie
          sociale et solidaire. Construire Orée est le journal public de cette
          construction.
        </p>
      </div>

      <aside class="threshold-status" aria-labelledby="etat-actuel">
        <p class="section-kicker section-kicker--inverse">État actuel</p>
        <h2 id="etat-actuel">Point zéro</h2>
        <p>
          La marketplace n’est pas encore ouverte : aucun catalogue, aucune
          vente, aucun utilisateur de marketplace. Le travail actuel consiste à
          documenter les fondations.
        </p>
      </aside>

      <div class="threshold-action">
        <a class="button button-primary" href="/projet/">Découvrir le projet</a>
      </div>
    </div>
  </section>

  <section class="home-orientation" aria-labelledby="orientation-title">
    <div class="container">
      <p class="section-kicker">Orientation</p>
      <h2 id="orientation-title">Cinq portes</h2>
      <ol class="door-list">
        {
          doors.map((door) => (
            <li>
              <a href={door.href} class="door-link">
                <span class="door-index" aria-hidden="true">
                  {door.index}
                </span>
                <span class="door-content">
                  <span class="door-title">{door.title}</span>
                  <span class="door-copy">{door.copy}</span>
                </span>
                <span class="door-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="home-section" aria-labelledby="problem-title">
    <div class="container reading-width">
      <p class="section-kicker">Question de départ</p>
      <h2 id="problem-title">Le problème et le renversement cherché</h2>
      <p>
        Vendre son art ne devrait pas exiger de devenir, en même temps,
        communicant, commerçant, spécialiste de l’administratif et entrepreneur.
        Beaucoup de personnes talentueuses n’osent pas commencer, freinées par
        la peur du jugement, de l’échec, de l’administratif ou par un manque de
        légitimité perçue.
      </p>
      <p>
        Aujourd’hui, la personne qui crée se présente et un système la juge.
        Orée cherche à inverser ce mouvement : que le système repère, ouvre une
        porte, et laisse la personne choisir.
      </p>
      <a class="text-link" href="/projet/">Lire le manifeste complet</a>
    </div>
  </section>

  <section
    class="home-section home-section--ruled"
    aria-labelledby="ecosystem-title"
  >
    <div class="container reading-width">
      <p class="section-kicker">Vision d’ensemble</p>
      <h2 id="ecosystem-title">L’écosystème en un seul schéma</h2>
      <p>
        Orée est au point zéro. L’écosystème présenté ici n’existe pas encore :
        il sert à rendre lisible la direction du projet et les liens que la
        future marketplace cherchera à créer.
      </p>
      <p>
        Des personnes qui créent, et d’autres qui pourront découvrir leurs
        œuvres ou leurs savoir-faire.
      </p>
      <p>Repérer, raconter, recommander et mettre en lumière les créations.</p>
      <p>
        Éclairer les sujets techniques, juridiques, fiscaux et opérationnels du
        projet.
      </p>
      <p>
        Des communautés locales envisagées et un horizon coopératif à long
        terme, tous deux conditionnels.
      </p>
      <a class="text-link" href="/ecosysteme/"
        >Comprendre l’écosystème en détail</a
      >
    </div>
  </section>

  <section
    class="home-section home-section--ruled"
    aria-labelledby="journal-title"
  >
    <div class="container reading-width">
      <p class="section-kicker">Journal</p>
      {
        latestEntry ? (
          <>
            <h2 id="journal-title">{latestEntry.data.title}</h2>
            <p>{latestEntry.data.description}</p>
            <a class="text-link" href={`/journal/${latestEntry.id}/`}>
              Lire l’article
            </a>
          </>
        ) : (
          <>
            <h2 id="journal-title">Le Journal de Construire Orée</h2>
            <p>Aucun billet n’est publié pour le moment.</p>
            <a class="text-link" href="/journal/">
              Lire le Journal
            </a>
          </>
        )
      }
    </div>
  </section>

  <section
    class="home-section home-section--ruled home-participate"
    aria-labelledby="participate-title"
  >
    <div class="container reading-width">
      <p class="section-kicker">Participer</p>
      <h2 id="participate-title">Participer ou suivre</h2>
      <p>Tu veux comprendre où ta contribution pourrait être utile ?</p>
      <div class="participate-actions">
        <a class="button button-primary" href="/rejoindre/">Participer</a>
        <a class="text-link" href={siteConfig.links.follow}
          >Suis l’aventure (formulaire externe)</a
        >
      </div>
      <p class="participate-note">
        Ces liens ouvrent des formulaires Tally externes. Leur envoi n’emporte
        ni réponse automatique ni engagement de part et d’autre.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .home-threshold {
    background: var(--color-canopy);
    color: var(--color-linen);
    padding-block: clamp(var(--space-12), 9vw, var(--space-24));
  }

  .home-threshold h1,
  .home-threshold h2 {
    color: var(--color-linen);
  }

  .home-threshold-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.62fr);
    grid-template-areas:
      "copy status"
      "action status";
    gap: var(--space-8) clamp(var(--space-12), 9vw, var(--space-24));
    align-items: start;
  }

  .threshold-copy {
    grid-area: copy;
    max-width: 44rem;
  }

  .section-kicker {
    margin-bottom: var(--space-3);
    padding-left: var(--space-3);
    border-left: 2px solid var(--color-dawn);
    color: var(--color-bark);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .section-kicker--inverse {
    color: var(--color-linen);
  }

  .threshold-copy h1 {
    margin-bottom: var(--space-6);
  }

  .threshold-introduction {
    margin-bottom: 0;
    font-size: var(--text-md);
  }

  .threshold-status {
    grid-area: status;
    padding-left: var(--space-6);
    border-left: 2px solid var(--color-dawn);
  }

  .threshold-status h2 {
    margin-bottom: var(--space-4);
  }

  .threshold-status p:last-child {
    margin-bottom: 0;
  }

  .threshold-action {
    grid-area: action;
  }

  .button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-6);
    border: 2px solid transparent;
    border-radius: var(--radius-md);
    font-weight: 700;
    text-align: center;
    text-decoration: none;
  }

  .button-primary {
    background: var(--color-action);
    color: var(--color-white);
  }

  .button-primary:hover {
    background: var(--color-action-hover);
    color: var(--color-white);
  }

  .home-threshold .button:focus-visible {
    outline-color: var(--color-linen);
  }

  .home-orientation,
  .home-section {
    padding-block: clamp(var(--space-12), 7vw, var(--space-24));
  }

  .home-orientation h2,
  .home-section h2 {
    margin-bottom: var(--space-6);
  }

  .door-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
    list-style: none;
  }

  .door-list li {
    max-width: none;
    border-bottom: 1px solid var(--color-border);
  }

  .door-link {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) 44px;
    gap: var(--space-4);
    min-height: 7.5rem;
    align-items: center;
    color: var(--color-text);
    text-decoration: none;
  }

  .door-link:hover {
    color: var(--color-action);
  }

  .door-index {
    color: var(--color-dawn);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-variant-numeric: lining-nums;
  }

  .door-content {
    display: grid;
    gap: var(--space-1);
  }

  .door-title {
    color: var(--color-canopy);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.15;
  }

  .door-copy {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .door-arrow {
    display: grid;
    min-width: 44px;
    min-height: 44px;
    place-items: center;
    color: var(--color-action);
    font-size: 1.8rem;
  }

  .home-section--ruled {
    border-top: 1px solid var(--color-terracotta);
  }

  .home-section p {
    font-size: var(--text-base);
  }

  .text-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--color-action);
    font-weight: 700;
  }

  .text-link::after {
    margin-left: var(--space-2);
    content: "→";
  }

  .participate-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .participate-note {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-sm) !important;
  }

  @media (max-width: 48rem) {
    .home-threshold-grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        "copy"
        "status"
        "action";
      gap: var(--space-8);
    }

    .threshold-status {
      max-width: 38rem;
    }
  }

  @media (max-width: 30rem) {
    .door-link {
      grid-template-columns: 3.5rem minmax(0, 1fr) 32px;
      gap: var(--space-2);
      min-height: 0;
      padding-block: var(--space-4);
    }

    .door-title {
      font-size: var(--text-md);
    }

    .door-arrow {
      min-width: 32px;
    }

    .participate-actions {
      display: grid;
    }

    .button {
      width: 100%;
    }
  }

  @media (forced-colors: active) {
    .home-threshold,
    .button-primary {
      border: 1px solid CanvasText;
    }

    .door-link:focus-visible,
    .text-link:focus-visible,
    .button:focus-visible {
      outline-color: Highlight;
    }
  }
</style>
