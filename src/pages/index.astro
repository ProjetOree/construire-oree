---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SeuilHero from "../components/home/SeuilHero.astro";
import EcosystemSchema from "../components/EcosystemSchema.astro";
import HomeDoors from "../components/home/HomeDoors.astro";
import { siteConfig } from "../config/site";

const publishedEntries = (await getCollection("journal"))
  .filter((entry) => !entry.data.draft && entry.data.publishedAt)
  .sort((a, b) => {
    const dateA = a.data.publishedAt?.valueOf() ?? 0;
    const dateB = b.data.publishedAt?.valueOf() ?? 0;
    return dateB - dateA;
  });
const latestEntry = publishedEntries[0];

const doors = [
  {
    index: "01",
    title: "Comprendre — Projet",
    copy: "Le problème de départ, l’utilité recherchée et le modèle envisagé.",
    href: "/projet/",
  },
  {
    index: "02",
    title: "Vérifier — Avancement",
    copy: "L’état réel et vérifiable, sans date inventée.",
    href: "/avancement/",
  },
  {
    index: "03",
    title: "Lire — Journal",
    copy: "Les billets réellement publiés sur la construction de Construire Orée.",
    href: "/journal/",
  },
  {
    index: "04",
    title: "Approfondir — Fondations",
    copy: "Les contraintes et arbitrages techniques, juridiques, fiscaux et opérationnels.",
    href: "/fondations/",
  },
  {
    index: "05",
    title: "Participer — Rejoindre",
    copy: "Les rôles envisagés et les manières de proposer un appui aujourd’hui.",
    href: "/rejoindre/",
  },
];
---

<BaseLayout
  title="Journal public d’un projet au point zéro"
  description="Construire Orée documente, au point zéro, la construction publique d’une future marketplace éthique pour la création originale faite main."
  composition="sceau"
>
  <SeuilHero />
  <HomeDoors doors={doors} />

  <section class="seuil-documents" aria-labelledby="seuil-doc-title">
    <div class="container document-gateway">
      <div>
        <p class="section-kicker" data-seuil-reveal="rule">
          Corpus et documents sources
        </p>
        <h2 id="seuil-doc-title" data-seuil-reveal>Lire les fondations.</h2>
      </div>
      <p>
        Les textes sources, leurs notes de contexte et les questions encore
        ouvertes.
      </p>
      <a class="text-link" href="/documents/"
        >Explorer les documents <span aria-hidden="true" data-seuil-link-arrow
          >→</span
        ></a
      >
    </div>
  </section>

  <section
    class="home-section seuil-context"
    aria-labelledby="seuil-context-title"
  >
    <div class="container context-grid">
      <div>
        <p class="section-kicker" data-seuil-reveal="rule">
          Journal public de construction
        </p>
        <h2 id="seuil-context-title" data-seuil-reveal>
          Une construction publique
        </h2>
      </div>
      <div class="context-copy">
        <p>
          Orée cherche à simplifier le premier pas des artistes et artisans —
          visibilité, vente et administratif — sans leur demander de tout
          porter.
        </p>
        <p>
          Construire Orée rend publics les arbitrages nécessaires pour donner
          vie à cette plateforme, dans une perspective d’économie sociale et
          solidaire.
        </p>
        <p>
          Construire Orée sert aujourd’hui à rendre les choix compréhensibles, à
          les confronter aux expériences d’artistes, d’artisans, d’Éclaireurs et
          d’Échos, et à chercher les expertises ou partenariats, institutionnels
          ou non, capables d’aider à donner vie à la plateforme.
        </p>
      </div>
    </div>
  </section>

  <section class="home-section" aria-labelledby="problem-title">
    <div class="container reading-width">
      <p class="section-kicker" data-seuil-reveal="rule">Question de départ</p>
      <h2 id="problem-title" data-seuil-reveal>
        Le problème et le renversement cherché
      </h2>
      <p>
        Vendre son art ne devrait pas exiger de devenir, en même temps,
        communicant, commerçant, spécialiste de l’administratif et entrepreneur.
        Beaucoup de personnes talentueuses n’osent pas commencer, freinées par
        la peur du jugement, de l’échec, de l’administratif ou par un manque de
        légitimité perçue.
      </p>
      <p>
        Aujourd’hui, la personne qui crée se présente et un système la juge.
        Orée cherche à inverser ce mouvement : que le système repère, ouvre une
        porte, et laisse la personne choisir.
      </p>
      <a class="text-link" href="/projet/">Comprendre le projet et son modèle</a
      >
    </div>
  </section>

  <section
    class="home-section home-section--ruled"
    aria-labelledby="ecosystem-title"
  >
    <div class="container reading-width">
      <p class="section-kicker" data-seuil-reveal="rule">Vision d’ensemble</p>
      <h2 id="ecosystem-title" data-seuil-reveal>
        L’écosystème en un seul schéma
      </h2>
      <p>
        Orée est au point zéro. L’écosystème présenté ici n’existe pas encore :
        il sert à rendre lisible la direction du projet et les liens que la
        future marketplace cherchera à créer.
      </p>
      <p>
        Des personnes qui créent, et d’autres qui pourront découvrir leurs
        œuvres ou leurs savoir-faire.
      </p>
      <p>Repérer, raconter, recommander et mettre en lumière les créations.</p>
      <p>
        Éclairer les sujets techniques, juridiques, fiscaux et opérationnels du
        projet.
      </p>
      <p>
        Des communautés locales envisagées et un horizon coopératif à long
        terme, tous deux conditionnels.
      </p>
      <EcosystemSchema id="home-ecosystem-schema" />
      <a class="text-link" href="/ecosysteme/"
        >Comprendre l’écosystème en détail</a
      >
    </div>
  </section>

  <section
    class="home-section home-section--ruled"
    aria-labelledby="journal-title"
  >
    <div class="container reading-width">
      <p class="section-kicker" data-seuil-reveal="rule">Journal</p>
      {
        latestEntry ? (
          <>
            <h2 id="journal-title" data-seuil-reveal>
              {latestEntry.data.title}
            </h2>
            <p>{latestEntry.data.description}</p>
            <a class="text-link" href={`/journal/${latestEntry.id}/`}>
              Lire l’article
            </a>
          </>
        ) : (
          <>
            <h2 id="journal-title" data-seuil-reveal>
              Le Journal de Construire Orée
            </h2>
            <p>Aucun billet n’est publié pour le moment.</p>
            <a class="text-link" href="/journal/">
              Lire le Journal
            </a>
          </>
        )
      }
    </div>
  </section>

  <section
    class="home-section home-section--ruled home-participate"
    aria-labelledby="participate-title"
    data-seuil-ambient="paper"
  >
    <div class="seuil-light" aria-hidden="true"></div>
    <div class="container reading-width">
      <p class="section-kicker" data-seuil-reveal="rule">Participer</p>
      <h2 id="participate-title" data-seuil-reveal>Participer ou suivre</h2>
      <p>
        Vous souhaitez comprendre où votre contribution pourrait être utile ?
      </p>
      <div class="participate-actions">
        <a class="button button-primary" href="/rejoindre/" data-seuil-button
          >Participer</a
        >
        <a class="text-link" href={siteConfig.links.follow}
          >Suivez l’aventure (formulaire externe)</a
        >
      </div>
      <p class="participate-note">
        Le lien « Suivez l’aventure » ouvre un formulaire Tally externe. Son
        envoi n’emporte ni réponse automatique ni engagement de part et d’autre.
        La page Participer reste sur ce site.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .section-kicker {
    margin-bottom: 0.5rem;
    padding-left: 0.75rem;
    position: relative;
    align-self: start;
    line-height: 1.2;
    color: var(--color-bark);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .section-kicker::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.1em;
    width: 2px;
    height: 1em;
    background: #c88a56;
  }
  .seuil-documents {
    padding-block: 2.25rem;
    background: var(--color-surface-soft);
    border-bottom: 1px solid rgba(24, 43, 34, 0.12);
  }
  .document-gateway {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }
  .document-gateway h2 {
    margin: 0;
    font-size: 1.875rem;
  }
  .document-gateway p {
    margin-bottom: 0;
  }
  .home-section {
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
  }
  .home-section h2 {
    margin-bottom: 1.5rem;
  }
  .home-section p {
    font-size: var(--text-base);
  }
  .home-section .reading-width {
    max-width: var(--layout-width);
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    grid-template-rows: 0.9rem auto;
    gap: 0.5rem 4rem;
    align-items: start;
  }
  .home-section .reading-width > .section-kicker {
    grid-column: 1;
  }
  .home-section .reading-width > h2 {
    grid-column: 1;
    grid-row: 2;
    max-width: 17ch;
  }
  .home-section
    .reading-width
    > :is(p:not(.section-kicker), a, .participate-actions) {
    grid-column: 2;
    max-width: var(--content-width);
  }
  .home-section .reading-width > p:not(.section-kicker) {
    margin: 0 0 0.5rem;
  }
  .home-section .reading-width > .section-kicker + h2 + p {
    grid-row: 1 / span 2;
  }
  .home-section .reading-width > :global(.ecosystem-schema) {
    grid-column: 1 / -1;
    width: 100%;
    margin-block: 1rem;
  }
  .home-section--ruled {
    border-top: 1px solid rgba(24, 43, 34, 0.12);
  }
  .context-grid {
    display: grid;
    gap: 1.5rem 4rem;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }
  .context-grid > * {
    min-width: 0;
  }
  .context-copy p:last-child {
    margin-bottom: 0;
  }
  .seuil-context {
    background: var(--color-canvas);
    border-bottom: 1px solid rgba(24, 43, 34, 0.12);
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    width: fit-content;
    color: var(--color-action);
    font-weight: 700;
  }
  .text-link:visited {
    color: var(--color-action);
  }
  .button {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 1.5rem;
    border: 2px solid transparent;
    border-radius: 3px;
    font-weight: 650;
    text-align: center;
    text-decoration: none;
  }
  .button-primary {
    background: var(--color-action);
    color: var(--color-white);
  }
  .button-primary:visited {
    color: var(--color-white);
  }
  .button-primary:hover {
    background: var(--color-action-hover);
    color: var(--color-white);
  }
  .participate-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
  .participate-note {
    color: var(--color-text-muted);
    font-size: 1rem !important;
  }
  @media (min-width: 75rem) {
    .document-gateway {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr) auto;
      gap: 3rem;
    }
  }
  @media (max-width: 56rem) {
    .context-grid,
    .home-section .reading-width {
      display: block;
    }
    .home-section .reading-width > h2 {
      max-width: none;
    }
    .home-section .reading-width > p:not(.section-kicker) {
      margin-bottom: 1rem;
    }
    .context-copy {
      margin-top: 1.5rem;
    }
  }
  @media (max-width: 30rem) {
    .participate-actions {
      display: grid;
    }
    .button {
      width: 100%;
    }
  }
  @media (forced-colors: active) {
    .button-primary {
      border-color: CanvasText;
    }
    .button:focus-visible {
      outline-color: Highlight;
    }
  }
</style>
